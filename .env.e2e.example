# Copy to .env.e2e.local; never put these credentials in .env.local.
# The suite refuses the existing FleetFalcon development project.
E2E_TARGET_ENVIRONMENT=isolated-e2e
E2E_SUPABASE_PROJECT_REF=
E2E_SUPABASE_URL=
E2E_SUPABASE_PUBLISHABLE_KEY=
E2E_SUPABASE_ADMIN_KEY=
# Comma-separated refs. Append customer-facing production projects when created.
E2E_PROTECTED_PROJECT_REFS=kgmxzjnqowsishsiyjug
